{
    "swagger": "2.0",
    "info": {
        "description": "API Service Backend untuk Sistem Informasi e-Posyandu berbasis Go Fiber.",
        "title": "e-Posyandu API Documentation",
        "termsOfService": "http://swagger.io/terms/",
        "contact": {
            "name": "Tim Pengembang e-Posyandu",
            "email": "admin@eposyandu.local"
        },
        "license": {
            "name": "MIT",
            "url": "https://opensource.org/licenses/MIT"
        },
        "version": "1.0"
    },
    "host": "localhost:3000",
    "basePath": "/api/v1",
    "paths": {
        "/auth/login": {
            "post": {
                "description": "Otentikasi pengguna untuk mendapatkan JWT Token",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "Auth"
                ],
                "summary": "Login Pengguna",
                "parameters": [
                    {
                        "description": "Kredensial Login",
                        "name": "request",
                        "in": "body",
                        "required": true,
                        "schema": {
                            "$ref": "#/definitions/controllers.LoginInput"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Login berhasil dan token diterbitkan",
                        "schema": {
                            "type": "object",
                            "additionalProperties": true
                        }
                    },
                    "400": {
                        "description": "Format request tidak valid",
                        "schema": {
                            "type": "object",
                            "additionalProperties": true
                        }
                    },
                    "401": {
                        "description": "Email atau password salah",
                        "schema": {
                            "type": "object",
                            "additionalProperties": true
                        }
                    },
                    "500": {
                        "description": "Gagal membuat token autentikasi",
                        "schema": {
                            "type": "object",
                            "additionalProperties": true
                        }
                    }
                }
            }
        },
        "/auth/register": {
            "post": {
                "description": "Pendaftaran pengguna baru dengan role tertentu (default: ortu)",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "Auth"
                ],
                "summary": "Registrasi Pengguna Baru",
                "parameters": [
                    {
                        "description": "Data Registrasi Pengguna",
                        "name": "request",
                        "in": "body",
                        "required": true,
                        "schema": {
                            "$ref": "#/definitions/controllers.RegisterInput"
                        }
                    }
                ],
                "responses": {
                    "201": {
                        "description": "Registrasi berhasil",
                        "schema": {
                            "type": "object",
                            "additionalProperties": true
                        }
                    },
                    "400": {
                        "description": "Format request atau data tidak valid",
                        "schema": {
                            "type": "object",
                            "additionalProperties": true
                        }
                    },
                    "500": {
                        "description": "Gagal memproses password",
                        "schema": {
                            "type": "object",
                            "additionalProperties": true
                        }
                    }
                }
            }
        },
        "/kms": {
            "post": {
                "security": [
                    {
                        "BearerAuth": []
                    }
                ],
                "description": "Mencatat hasil penimbangan balita dan mengkalkulasi otomatis status Z-Score WHO (Status Gizi \u0026 Stunting)",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "KMS \u0026 Penimbangan"
                ],
                "summary": "Catat Penimbangan \u0026 Tumbuh Kembang Anak (KMS)",
                "parameters": [
                    {
                        "description": "Data Penimbangan Anak",
                        "name": "request",
                        "in": "body",
                        "required": true,
                        "schema": {
                            "$ref": "#/definitions/controllers.CreateKMSInput"
                        }
                    }
                ],
                "responses": {
                    "201": {
                        "description": "Catatan KMS berhasil ditambahkan",
                        "schema": {
                            "type": "object",
                            "additionalProperties": true
                        }
                    },
                    "400": {
                        "description": "Format request atau tanggal tidak valid",
                        "schema": {
                            "type": "object",
                            "additionalProperties": true
                        }
                    },
                    "401": {
                        "description": "Tidak terautentikasi",
                        "schema": {
                            "type": "object",
                            "additionalProperties": true
                        }
                    },
                    "404": {
                        "description": "Data anak tidak ditemukan",
                        "schema": {
                            "type": "object",
                            "additionalProperties": true
                        }
                    },
                    "500": {
                        "description": "Gagal menyimpan data penimbangan",
                        "schema": {
                            "type": "object",
                            "additionalProperties": true
                        }
                    }
                }
            }
        },
        "/kms/anak/{anak_id}": {
            "get": {
                "security": [
                    {
                        "BearerAuth": []
                    }
                ],
                "description": "Melihat histori penimbangan dan catatan tumbuh kembang balita berdasarkan ID Anak",
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "KMS \u0026 Penimbangan"
                ],
                "summary": "Riwayat KMS Balita",
                "parameters": [
                    {
                        "type": "integer",
                        "description": "ID Anak",
                        "name": "anak_id",
                        "in": "path",
                        "required": true
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Data riwayat KMS balita",
                        "schema": {
                            "type": "object",
                            "additionalProperties": true
                        }
                    },
                    "401": {
                        "description": "Tidak terautentikasi",
                        "schema": {
                            "type": "object",
                            "additionalProperties": true
                        }
                    },
                    "500": {
                        "description": "Gagal mengambil data riwayat KMS",
                        "schema": {
                            "type": "object",
                            "additionalProperties": true
                        }
                    }
                }
            }
        },
        "/user/profile": {
            "get": {
                "security": [
                    {
                        "BearerAuth": []
                    }
                ],
                "description": "Mengambil data profil lengkap pengguna yang sedang login berdasarkan JWT Token",
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "Auth"
                ],
                "summary": "Ambil Profil Pengguna",
                "responses": {
                    "200": {
                        "description": "Data profil pengguna",
                        "schema": {
                            "type": "object",
                            "additionalProperties": true
                        }
                    },
                    "401": {
                        "description": "Tidak terautentikasi",
                        "schema": {
                            "type": "object",
                            "additionalProperties": true
                        }
                    },
                    "404": {
                        "description": "Pengguna tidak ditemukan",
                        "schema": {
                            "type": "object",
                            "additionalProperties": true
                        }
                    }
                }
            }
        }
    },
    "definitions": {
        "controllers.CreateKMSInput": {
            "type": "object",
            "properties": {
                "anak_id": {
                    "type": "integer",
                    "example": 1
                },
                "berat_badan_kg": {
                    "type": "number",
                    "example": 9.5
                },
                "catatan": {
                    "type": "string",
                    "example": "Tumbuh kembang baik, berikan ASI dan MPASI bergizi"
                },
                "lingkar_kepala_cm": {
                    "type": "number",
                    "example": 45.5
                },
                "tanggal_timbang": {
                    "description": "YYYY-MM-DD",
                    "type": "string",
                    "example": "2026-09-22"
                },
                "tinggi_badan_cm": {
                    "type": "number",
                    "example": 75
                },
                "usia_bulan": {
                    "type": "integer",
                    "example": 12
                }
            }
        },
        "controllers.LoginInput": {
            "type": "object",
            "properties": {
                "email": {
                    "type": "string",
                    "example": "admin@eposyandu.local"
                },
                "password": {
                    "type": "string",
                    "example": "admin123"
                }
            }
        },
        "controllers.RegisterInput": {
            "type": "object",
            "properties": {
                "email": {
                    "type": "string",
                    "example": "ahmad@example.com"
                },
                "nama": {
                    "type": "string",
                    "example": "Ahmad"
                },
                "nama_lengkap": {
                    "type": "string",
                    "example": "Ahmad Dahlan"
                },
                "nik": {
                    "type": "string",
                    "example": "1234567890123456"
                },
                "no_hp": {
                    "type": "string",
                    "example": "081234567890"
                },
                "password": {
                    "type": "string",
                    "example": "password123"
                },
                "role": {
                    "type": "string",
                    "example": "ortu"
                }
            }
        }
    },
    "securityDefinitions": {
        "BearerAuth": {
            "description": "Masukkan token JWT dengan format: Bearer \u003ctoken\u003e",
            "type": "apiKey",
            "name": "Authorization",
            "in": "header"
        }
    }
}